<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.VideoDownloader" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorOnPrimary">@color/onPrimaryColor</item>

        <item name="colorSecondary">@color/primaryColor</item>
        <item name="colorOnSecondary">@color/onPrimaryColor</item>

        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="colorOnBackground">@color/onBackground</item>
        <item name="android:fontFamily">@font/segoe_regular</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="FullScreenDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="RoundMediaTen">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10%</item>
    </style>
    <style name="Corners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">@dimen/_12sdp</item>
        <item name="cornerSizeBottomRight">@dimen/_12sdp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>
    <style name="RatingBar" parent="Widget.AppCompat.RatingBar.Small">
        <item name="android:minHeight">@dimen/_7sdp</item>
        <item name="android:maxHeight">@dimen/_7sdp</item>
        <item name="colorControlNormal">#BCBCBC</item>
        <item name="colorControlActivated">#FFD600</item>
    </style>
    <style name="Theme.VideoDownloader" parent="Base.Theme.VideoDownloader" />
</resources>