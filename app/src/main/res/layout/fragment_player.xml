<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:paddingHorizontal="@dimen/_10sdp"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".features.ui.fragments.PlayerFragment">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        app:strokeWidth="0dp"
        android:id="@+id/all_Video_Button"
        android:layout_marginEnd="@dimen/_40sdp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_10sdp"
        app:cardCornerRadius="@dimen/_8sdp"
        app:cardBackgroundColor="@color/primaryColor"
        app:layout_constraintEnd_toStartOf="@+id/all_Music_button"
        app:layout_constraintStart_toStartOf="@+id/chipRecycler"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:paddingVertical="@dimen/_10sdp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <ImageView
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:src="@drawable/icon_all_videos"/>
            <TextView
                android:fontFamily="@font/segoe_bold"
                android:textColor="@color/white"
                android:layout_marginEnd="@dimen/_10sdp"
                android:textSize="@dimen/_12ssp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_videos"/>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:id="@+id/all_Music_button"
        app:strokeWidth="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_10sdp"
        app:cardCornerRadius="@dimen/_8sdp"
        app:cardBackgroundColor="@color/primaryColor"
        app:layout_constraintStart_toEndOf="@id/all_Video_Button"
        app:layout_constraintEnd_toEndOf="@+id/chipRecycler"
        app:layout_constraintTop_toTopOf="parent" >
        <LinearLayout
            android:paddingVertical="@dimen/_10sdp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <ImageView
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:src="@drawable/icon_all_music"/>
            <TextView
                android:fontFamily="@font/segoe_bold"
                android:textColor="@color/white"
                android:layout_marginEnd="@dimen/_10sdp"
                android:textSize="@dimen/_12ssp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_music"/>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <androidx.recyclerview.widget.RecyclerView
        tools:listitem="@layout/item_chip_layout"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="horizontal"
        android:id="@+id/chipRecycler"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/all_Music_button" />

    <androidx.recyclerview.widget.RecyclerView
        tools:listitem="@layout/item_media_recycler"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        android:id="@+id/media_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_15sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipRecycler"/>



</androidx.constraintlayout.widget.ConstraintLayout>