<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="@dimen/_8sdp"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardBackgroundColor="@color/insta_card_color"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    android:id="@+id/rootCard"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:padding="@dimen/_10sdp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_50sdp"
                android:src="@drawable/human_pics"/>

            <TextView
                android:textColor="@color/onBackground"
                android:fontFamily="@font/segoe_bold"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/view_stories_private" />
            <ImageView
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_lock"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_insta_button"
            app:icon="@drawable/instagram_open_icon"
            app:iconGravity="textEnd"
            app:backgroundTint="@null"
            android:background="@drawable/gradient_background"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_30sdp"
            android:text="@string/open_instagram"
            android:fontFamily="@font/segoe_bold"
            android:textAllCaps="false"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:textColor="@color/onBackground"
            android:fontFamily="@font/segoe_regular"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textSize="12dp"
            android:ellipsize="end"
            android:layout_marginVertical="@dimen/_10sdp"
            android:text="@string/why_login_required" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>