<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white"
    tools:context=".features.ui.fragments.FreeTrailFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:padding="@dimen/_10sdp">

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_10sdp"
                android:src="@drawable/ic_close_circle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/ivPerson"
                android:layout_width="@dimen/_160sdp"
                android:layout_height="@dimen/_160sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/sss_1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/textImage"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/free_trail_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivPerson"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_50sdp"
                android:fontFamily="@font/segoe_semibold"
                android:text="Try all PRO features free for 3 Days."
                android:textSize="@dimen/_11sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textImage" />

            <TextView
                android:id="@+id/tvHeaderSubtitle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_50sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/segoe_semibold"
                android:text="Cancel anytime."
                android:textSize="@dimen/_11sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderSubtitle" />

            <LinearLayout
                android:id="@+id/linear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderSubtitle2">

                <com.codecx.videodownloader.features.ui.views.FreeTrailTimeButton
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_weight="1"
                    app:des="Downloads"
                    app:icon="@drawable/new_download_icon"
                    app:strokeColor="#99FFDCE8"
                    app:tile_backgroundEndColor="#FFEBF2"
                    app:tile_backgroundStartColor="#FFF0F5"
                    app:tile_imageEndColor="#E91E63"
                    app:tile_imageStartColor="#FF337E"
                    app:title="Unlimited"
                    app:view_color="#F51F70" />

                <com.codecx.videodownloader.features.ui.views.FreeTrailTimeButton
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_weight="1"
                    app:des="Downloads"
                    app:icon="@drawable/hd_icon"
                    app:strokeColor="#99FFDFC6"
                    app:tile_backgroundEndColor="#FFEDE0"
                    app:tile_backgroundStartColor="#FFF6EE"
                    app:tile_imageEndColor="#FF8914"
                    app:tile_imageStartColor="#FFB03A"
                    app:title="Hd &amp; 4K"
                    app:view_color="#FF9800" />

                <com.codecx.videodownloader.features.ui.views.FreeTrailTimeButton
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:des="Experience"
                    app:icon="@drawable/no_ads_icon"
                    app:strokeColor="#B3E4D5FF"
                    app:tile_backgroundEndColor="#EFE7FF"
                    app:tile_backgroundStartColor="#F7F2FF"
                    app:tile_imageEndColor="#8048F7"
                    app:tile_imageStartColor="#A879FF"
                    app:title="No Ads"
                    app:view_color="#9B6DFF" />
            </LinearLayout>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFreeTrial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="22dp"
                app:layout_constraintTop_toBottomOf="@id/linear"
                app:strokeColor="#3AFF1E6A"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_gradient"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="@dimen/_8sdp">


                    <ImageView
                        android:id="@+id/ivSparkles"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/stars"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />


                    <com.google.android.material.card.MaterialCardView

                        android:id="@+id/iconCard"
                        android:layout_width="wrap_content"
                        app:cardCornerRadius="@dimen/_20sdp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        app:layout_constraintStart_toEndOf="@+id/ivSparkles"
                        app:layout_constraintTop_toTopOf="@+id/ivSparkles">
                        <LinearLayout
                            android:layout_margin="@dimen/_2sdp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:padding="@dimen/_8sdp"
                                android:background="@drawable/crown_gradient_bg"
                                android:layout_width="@dimen/_40sdp"
                                android:layout_height="@dimen/_40sdp"
                                android:src="@drawable/icon_crown_setting"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>



                    <TextView
                        android:id="@+id/tvBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_hot_pink"
                        android:fontFamily="@font/segoe_bold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="🔥 Limited Time Offer"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <TextView
                        android:id="@+id/header_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/segoe_bold"
                        android:text="3 Day Free Trial"
                        android:textColor="#1E202B"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:layout_constraintEnd_toStartOf="@id/tvBadge"
                        app:layout_constraintStart_toEndOf="@id/iconCard"
                        app:layout_constraintTop_toTopOf="@id/iconCard" />


                    <LinearLayout
                        android:id="@+id/layoutPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toEndOf="@id/iconCard"
                        app:layout_constraintTop_toBottomOf="@id/header_title">

                        <TextView
                            android:id="@+id/header_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/segoe_bold"
                            android:text="$2.99"
                            android:textColor="#FF1E6A"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/segoe_regular"
                            android:text="/ week"
                            android:textColor="#5A6478"
                            android:textSize="14sp" />
                    </LinearLayout>


                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/segoe_regular"
                        android:text="Starting today  •  Cancel anytime"
                        android:textColor="#727E94"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@id/iconCard"
                        app:layout_constraintTop_toBottomOf="@id/layoutPrice" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/start3DaysTrailBtn"
                app:layout_constraintTop_toBottomOf="@+id/cardFreeTrial"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_width="match_parent"
                app:cardCornerRadius="@dimen/_20sdp"
                app:strokeWidth="0dp"
                app:cardElevation="@dimen/_5sdp"
                android:layout_height="wrap_content"
                >
                <LinearLayout
                    android:padding="@dimen/_13sdp"
                    android:gravity="center"
                    android:background="@drawable/btn_gradient"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:id="@+id/tvBtnText"
                        android:textColor="@color/white"
                        android:fontFamily="@font/segoe_bold"
                        android:textSize="@dimen/_12ssp"
                        android:text="Start 3-Days Free Trail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:layout_marginStart="@dimen/_5sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_rignt_round"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:padding="@dimen/_6sdp"
                app:layout_constraintTop_toBottomOf="@+id/start3DaysTrailBtn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/_10sdp"
                android:id="@+id/restore_purchase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restore Purchases"
                android:fontFamily="@font/segoe_regular"
                android:textColor="#8E92A0"
                android:textSize="@dimen/_10sdp"
                />

            <LinearLayout
                android:layout_marginTop="@dimen/_6sdp"
                android:id="@+id/term_and_service_text"
                app:layout_constraintTop_toBottomOf="@id/restore_purchase"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:fontFamily="@font/segoe_semibold"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="@dimen/_8ssp"
                    android:text="@string/your_subscription_will_renew_at_the_end_of_each_billing_cycle_term_amp_conditions"
                    />
                <TextView
                    android:id="@+id/textTermsAndCondition"
                    android:textColor="#E8605F"
                    android:fontFamily="@font/segoe_semibold"
                    android:textSize="@dimen/_8ssp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terms_amp_conditions"/>

            </LinearLayout>


            <TextView
                android:id="@+id/txt"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:fontFamily="@font/segoe_regular"
                android:textColor="#686B78"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintTop_toBottomOf="@id/term_and_service_text"
                android:text="Renews automatically.Cancel anytime."/>



        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
