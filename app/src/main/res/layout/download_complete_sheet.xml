<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tab_corner_round"
    android:paddingBottom="@dimen/_24sdp">

    <View
        android:id="@+id/topView"
        android:layout_marginTop="@dimen/_5sdp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="@dimen/_60sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_gravity="center_horizontal"
        android:background="@color/gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/close_btn"
        android:layout_margin="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/btn_close"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"/>

    <ImageView
        android:id="@+id/image_tick"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_30sdp"
        app:layout_constraintTop_toBottomOf="@+id/topView"
        android:src="@drawable/icon_tick"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

    <TextView
        android:textSize="@dimen/_12ssp"
        android:id="@+id/tv_downloadComplete"
        android:fontFamily="@font/segoe_semibold"
        android:layout_marginStart="@dimen/_10sdp"
        app:layout_constraintStart_toEndOf="@id/image_tick"
        app:layout_constraintTop_toTopOf="@id/image_tick"
        android:layout_width="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/image_tick"
        android:layout_height="wrap_content"
        android:text="@string/download_complete"/>


    <com.airbnb.lottie.LottieAnimationView
        app:lottie_loop="true"
        app:lottie_autoPlay="true"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:id="@+id/lottieAnimation"

        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_80sdp"
        app:lottie_rawRes="@raw/celebration_confetti"
        app:layout_constraintEnd_toStartOf="@id/close_btn"
        app:layout_constraintTop_toTopOf="parent"
        />


    <com.google.android.material.card.MaterialCardView
        android:layout_margin="@dimen/_20sdp"
        android:id="@+id/download_card"
        app:layout_constraintTop_toBottomOf="@id/lottieAnimation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:paddingVertical="@dimen/_15sdp"
            android:layout_height="match_parent">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ivThumbnailCard"
                android:layout_width="@dimen/_100sdp"
                android:layout_marginStart="@dimen/_10sdp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_height="@dimen/_60sdp">

                <ImageView
                    android:id="@+id/ivDownloadCompleteThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    />

            </com.google.android.material.card.MaterialCardView>


            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_14ssp"
                android:fontFamily="@font/segoe_bold"
                android:textColor="@color/onBackground"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_8sdp"
                app:layout_constraintTop_toTopOf="@id/ivThumbnailCard"
                app:layout_constraintStart_toEndOf="@id/ivThumbnailCard"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Author -->
            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_10ssp"
                android:fontFamily="@font/segoe_semibold"
                android:textColor="@color/onBackground"
                android:drawablePadding="4dp"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_4sdp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toEndOf="@id/ivThumbnailCard"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnOpenFolder"
                app:cardBackgroundColor="#E9F5EF"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_margin="@dimen/_10sdp"
                app:layout_constraintEnd_toStartOf="@id/btnShare"
                app:layout_constraintTop_toBottomOf="@id/ivThumbnailCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/folder_icon"
                        />
                    <TextView
                        android:maxLines="1"
                        android:textSize="@dimen/_10ssp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/segoe_semibold"
                        android:text="@string/open_folder"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnShare"

                app:layout_constraintEnd_toStartOf="@id/btnView"
                android:layout_margin="@dimen/_10sdp"
                app:cardBackgroundColor="#EDF3FC"
                app:layout_constraintTop_toBottomOf="@id/ivThumbnailCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView

                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/share_ic"
                        />
                    <TextView
                        android:textColor="#126AFD"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/segoe_semibold"
                        android:text="@string/share"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnView"
                app:cardBackgroundColor="@color/primaryColor"
                android:layout_margin="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivThumbnailCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:textColor="@color/white"
                        android:layout_marginHorizontal="@dimen/_6sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/segoe_semibold"
                        android:text="@string/view"/>

                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:src="@drawable/ic_cheveron_right"
                        app:tint="@color/white" />


                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>