<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbarLayout"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/back_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/onBackground" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Instagram"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold"
            android:textColor="@color/onBackground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:layout_height="0dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/card_color"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="#F6F7FB"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/ivSearchIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/link_icon"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <EditText
                                android:id="@+id/etUrl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@null"
                                android:hint="@string/search_or_paste_link_to_download"
                                android:inputType="textUri"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/ivSearchIcon"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPasteLink"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:fontFamily="@font/segoe_semibold"
                            android:paddingVertical="@dimen/_12sdp"
                            android:text="@string/paste_link"
                            android:textAllCaps="false"
                            android:textColor="@color/onBackground"
                            android:textSize="16sp"
                            app:backgroundTint="@android:color/transparent"
                            app:cornerRadius="22dp"
                            app:layout_constraintEnd_toStartOf="@id/btnDownload"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeColor="@color/stroke_colour"
                            app:strokeWidth="2dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDownload"
                            android:layout_width="0dp"
                            android:paddingVertical="@dimen/_12sdp"
                            android:layout_height="wrap_content"
                            android:text="@string/download"
                            android:textColor="@color/white"
                            app:cornerRadius="22dp"
                            android:fontFamily="@font/segoe_semibold"
                            android:textSize="16sp"
                            android:layout_marginStart="@dimen/_5sdp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/btnPasteLink" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <include
                android:visibility="gone"
                android:id="@+id/open_insta_button"
                layout="@layout/open_insta_layout"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_35sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="16dp"
                android:elevation="0dp"
                app:cardBackgroundColor="@android:color/transparent"
                android:padding="12dp"
                app:cardCornerRadius="@dimen/_20sdp"
                app:strokeColor="#707070"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/_8sdp"
                    android:text="@string/how_to_download"
                    android:textColor="@color/onBackground"
                    android:textSize="@dimen/_16ssp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>


            <!--Mai Card 1st Step-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step1Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_step_card"
                android:paddingHorizontal="@dimen/_12sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Step Number -->
                <TextView
                    android:layout_marginTop="@dimen/_12sdp"
                    android:id="@+id/tvStepNumber1"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:background="@drawable/bg_step_number"
                    android:gravity="center"
                    android:text="@string/_1"
                    android:textColor="@color/onBackground"
                    android:textSize="@dimen/_14ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Title -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:fontFamily="@font/segoe_semibold"
                    android:text="@string/copy_link"
                    android:textColor="@color/onBackground"
                    android:textSize="@dimen/_14ssp"
                    app:layout_constraintBottom_toBottomOf="@id/tvStepNumber1"
                    app:layout_constraintEnd_toStartOf="@+id/ivStepImage1"
                    app:layout_constraintStart_toEndOf="@id/tvStepNumber1"
                    app:layout_constraintTop_toTopOf="@id/tvStepNumber1" />

                <!-- Instructions -->
                <LinearLayout
                    android:id="@+id/instructionContainer1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivStepImage1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvStepNumber1">

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/segoe_semibold"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/_1_open_pinterest_amp_tap_the_3_dots"
                        android:textColor="@color/onBackground"
                        android:textSize="@dimen/_10ssp" />

                    <TextView
                        android:id="@+id/tvDescription1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="5dp"
                        android:fontFamily="@font/segoe_semibold"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/_2_click_copy_link"
                        android:textColor="@color/onBackground"
                        android:textSize="@dimen/_10ssp" />

                </LinearLayout>

                <!-- Phone Images -->
                <ImageView
                    android:layout_marginTop="@dimen/_10sdp"
                    android:id="@+id/ivStepImage1"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:src="@drawable/mobile_image"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Main Card 2nd Step -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step2Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_step_card"
                android:clipToPadding="false"
                android:padding="@dimen/_12sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Step Number -->
                <TextView
                    android:id="@+id/tvStepNumber2"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:background="@drawable/bg_step_number"
                    android:gravity="center"
                    android:text="@string/_2"
                    android:textColor="@color/onBackground"
                    android:textSize="@dimen/_12ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Title -->
                <TextView
                    android:id="@+id/step_2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:fontFamily="@font/segoe_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/open_the_app"
                    android:textColor="@color/onBackground"
                    android:textSize="@dimen/_12ssp"
                    app:layout_constraintBottom_toBottomOf="@id/tvStepNumber2"
                    app:layout_constraintEnd_toStartOf="@id/mGuideLine1"
                    app:layout_constraintStart_toEndOf="@id/tvStepNumber2"
                    app:layout_constraintTop_toTopOf="@id/tvStepNumber2" />

                <TextView
                    android:layout_marginTop="@dimen/_6sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/segoe_semibold"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:text="@string/the_copied_link_will_nbe_automatically_pasted_nsimply_tap_download"
                    android:textColor="@color/onBackground"
                    android:textSize="@dimen/_10ssp"
                    app:layout_constraintEnd_toStartOf="@id/mGuideLine1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvStepNumber2"/>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/mGuideLine1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintGuide_begin="155dp"
                    app:layout_constraintStart_toEndOf="@id/step_2_title" />


                <include
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/mGuideLine1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    layout="@layout/step2__preview_layout" />



            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- Main Card 3rd Step -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step3Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_step_card"
                android:clipToPadding="false"
                android:padding="@dimen/_12sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Step Number -->
                <TextView
                    android:id="@+id/tvStepNumber3"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:background="@drawable/bg_step_number"
                    android:gravity="center"
                    android:text="@string/_3"
                    android:textColor="@color/onBackground"
                    android:textSize="@dimen/_12ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Title -->
                <TextView

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/segoe_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/check_progress"
                    android:textColor="@color/onBackground"
                    android:textSize="@dimen/_12ssp"
                    app:layout_constraintBottom_toBottomOf="@id/tvStepNumber3"
                    app:layout_constraintEnd_toStartOf="@id/mGuideLine2"
                    app:layout_constraintStart_toEndOf="@id/tvStepNumber3"
                    app:layout_constraintTop_toTopOf="@id/tvStepNumber3" />

                <!-- Instructions -->
                <LinearLayout
                    android:id="@+id/instructionContainer3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@id/mGuideLine2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvStepNumber3">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/segoe_semibold"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/track_progress_and_open"
                        android:textColor="@color/onBackground"
                        android:textSize="@dimen/_10ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/segoe_semibold"
                        android:lineSpacingExtra="4dp"

                        android:text="@string/your_download_file"
                        android:textColor="@color/onBackground"
                        android:textSize="@dimen/_10ssp" />


                </LinearLayout>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/mGuideLine2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintGuide_begin="155dp"
                    app:layout_constraintStart_toStartOf="parent" />

                <include
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/mGuideLine2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    layout="@layout/step3_preview_layout" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- TikTok 1st Step -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/tiktokstep1Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_step_card"
                android:backgroundTint="@color/black"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_10sdp"
                android:visibility="gone"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Step Number -->
                <TextView
                    android:id="@+id/tvTiktokStepNumber1"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:background="@drawable/bg_step_number"
                    android:backgroundTint="@color/white"
                    android:gravity="center"
                    android:text="@string/_1"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_13ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Title -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:gravity="center"
                    android:text="@string/open_tiktok_and_click_share"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tvTiktokStepNumber1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvTiktokStepNumber1"
                    app:layout_constraintTop_toTopOf="@id/tvTiktokStepNumber1" />


                <ImageView
                    android:id="@+id/ivTiktokImage1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5sdp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/tiktok_click_share"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTiktokStepNumber1" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- TikTok 2nd Step -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/tiktokstep2Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_step_card"
                android:backgroundTint="@color/black"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_10sdp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Step Number -->
                <TextView
                    android:id="@+id/tvTiktokStepNumber2"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:background="@drawable/bg_step_number"
                    android:backgroundTint="@color/white"
                    android:gravity="center"
                    android:text="@string/_2"
                    android:textSize="@dimen/_13ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Title -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:gravity="center"
                    android:text="@string/copy_link_amp_open_video_downloader"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tvTiktokStepNumber2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvTiktokStepNumber2"
                    app:layout_constraintTop_toTopOf="@id/tvTiktokStepNumber2" />


                <ImageView
                    android:id="@+id/ivTiktokImage2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5sdp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/tiktok_share_image"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTiktokStepNumber2" />

            </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>





    </androidx.core.widget.NestedScrollView>





</androidx.constraintlayout.widget.ConstraintLayout>
