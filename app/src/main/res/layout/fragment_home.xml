<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    tools:context=".features.ui.fragments.HomeFragment">



    <TextView
        android:layout_marginStart="@dimen/_20sdp"
        android:id="@+id/tvTitle"
        android:fontFamily="@font/segoe_bold"

        android:layout_marginTop="@dimen/_10sdp"
        android:textSize="@dimen/_16sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_amp_download_videos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_15sdp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/search_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            android:paddingHorizontal="8dp"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F6F7FB"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/ivSearchIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/search_icon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/etUrl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:hint="@string/search_or_paste_link_to_download"
                        android:inputType="textUri"
                        android:textSize="@dimen/_12ssp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivSearchIcon"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPasteLink"
                android:layout_width="0dp"
                android:paddingVertical="@dimen/_12sdp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="@string/paste_link"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:fontFamily="@font/segoe_semibold"
                app:strokeWidth="2dp"
                app:cornerRadius="22dp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:textColor="@color/onBackground"
                app:backgroundTint="@android:color/transparent"
                app:layout_constraintEnd_toStartOf="@id/btnDownload"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardSearch"
                app:strokeColor="@color/stroke_colour" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownload"
                android:layout_width="0dp"
                android:paddingVertical="@dimen/_12sdp"
                android:layout_height="wrap_content"
                android:text="@string/download"
                android:textColor="@color/white"
                app:cornerRadius="22dp"
                android:fontFamily="@font/segoe_semibold"
                android:textSize="16sp"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_12sdp"
                app:layout_constraintTop_toBottomOf="@id/cardSearch"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnPasteLink" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvQuickAccess"
        android:textSize="@dimen/_14ssp"
        android:fontFamily="@font/segoe_semibold"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="@string/quick_access"
        app:layout_constraintTop_toBottomOf="@+id/card"
        />

    <ImageView
        android:layout_marginStart="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="@+id/tvQuickAccess"
        app:layout_constraintBottom_toBottomOf="@id/tvQuickAccess"
        app:layout_constraintStart_toEndOf="@+id/tvQuickAccess"
        android:src="@drawable/icon_star"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvQuickAccess">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:padding="@dimen/_10sdp"
            >

            <include
                android:id="@+id/facebook_button"
                layout="@layout/item_home_recycler" />
            <include
                android:id="@+id/whatsapp_button"
                layout="@layout/item_home_recycler" />
            <include
                android:id="@+id/instagram_button"
                layout="@layout/item_home_recycler" />
            <include
                android:id="@+id/tiktok_button"
                layout="@layout/item_home_recycler" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:padding="@dimen/_10sdp"
            >

            <include
                android:id="@+id/dailymotion_button"
                layout="@layout/item_home_recycler" />
            <include
                android:id="@+id/twitter_button"
                layout="@layout/item_home_recycler" />
            <include
                android:id="@+id/pintres_button"
                layout="@layout/item_home_recycler" />
            <include
                android:id="@+id/thread_button"
                layout="@layout/item_home_recycler" />
        </LinearLayout>
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>