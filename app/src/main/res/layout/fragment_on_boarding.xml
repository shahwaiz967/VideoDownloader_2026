<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/_10sdp"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".features.ui.fragments.OnBoardingFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/skip_btn"
        app:strokeWidth="0dp"
        app:cardCornerRadius="@dimen/_20sdp"
        app:cardBackgroundColor="@color/skip_btn"
        android:layout_margin="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:fontFamily="@font/segoe_semibold"
            android:textColor="@color/onBackground"
            android:layout_marginVertical="@dimen/_8sdp"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skip"/>
    </com.google.android.material.card.MaterialCardView>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skip_btn"
        app:layout_constraintBottom_toTopOf="@id/title"
        android:layout_margin="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>

    <FrameLayout
        android:id="@+id/ad_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        app:layout_constraintBottom_toTopOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView

        android:textColor="@color/onBackground"
        android:id="@+id/title"
        android:fontFamily="@font/segoe_bold"
        android:textSize="@dimen/_16ssp"
        android:layout_marginVertical="@dimen/_10sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fast_amp_easy_video_downloads"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/des" />
    <TextView
        android:textColor="@color/onBackground"
        android:layout_marginBottom="@dimen/_40sdp"
        android:gravity="center"
        android:id="@+id/des"
        android:layout_marginHorizontal="@dimen/_15ssp"
        android:fontFamily="@font/segoe_regular"
        android:textSize="@dimen/_12ssp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_videos_in_hd_quality_and_enjoy_seamless_offline_viewing_anytime_anywhere"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/next_btn"/>


    <com.google.android.material.button.MaterialButton
        android:text="@string/next"
        android:textSize="@dimen/_15ssp"
        android:fontFamily="@font/segoe_semibold"
        app:cornerRadius="@dimen/_10sdp"
        android:paddingVertical="@dimen/_10sdp"
        android:layout_margin="@dimen/_20sdp"
        app:icon="@drawable/icon_next_btn"
        app:iconGravity="end"
        app:iconSize="@dimen/_20ssp"
        android:id="@+id/next_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

</androidx.constraintlayout.widget.ConstraintLayout>