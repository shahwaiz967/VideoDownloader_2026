<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/tab_corner_round"
    android:paddingBottom="32dp">

    <View
        android:id="@+id/handle"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_marginTop="12dp"
        android:background="@color/gray"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Close -->
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/close_small_ic"
        android:padding="6dp"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Thumbnail -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ivThumbnailCard"
        android:layout_width="@dimen/_100sdp"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_14sdp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/handle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_height="@dimen/_60sdp">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            />

    </com.google.android.material.card.MaterialCardView>


    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_14ssp"
        android:fontFamily="@font/segoe_bold"
        android:textColor="@color/onBackground"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="@id/ivThumbnailCard"
        app:layout_constraintStart_toEndOf="@id/ivThumbnailCard"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Author -->
    <TextView
        android:id="@+id/tvAuthor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_10ssp"
        android:fontFamily="@font/segoe_semibold"
        android:textColor="@color/onBackground"
        android:drawablePadding="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toEndOf="@id/ivThumbnailCard"
        app:layout_constraintEnd_toEndOf="parent"/>




    <!-- Download Options List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDownloadOptions"
        android:layout_width="0dp"
        tools:listitem="@layout/item_download"
        tools:itemCount="3"
        android:clipToPadding="true"
        android:paddingVertical="@dimen/_10sdp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_10sdp"
        android:layout_marginHorizontal="@dimen/_14sdp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintTop_toBottomOf="@id/ivThumbnailCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>