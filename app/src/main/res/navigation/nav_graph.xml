<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.SplashFragment"
        tools:layout="@layout/fragment_splash"/>



    <fragment
        android:id="@+id/homeFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/languageFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.LanguageFragment"
        android:label="fragment_language"
        tools:layout="@layout/fragment_language"/>
    <fragment
        android:id="@+id/premiumFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.PremiumFragment"
        android:label="premium_fragment"
        tools:layout="@layout/fragment_premium"/>

    <fragment
        android:id="@+id/socityFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.SocietyFragment"
        android:label="socity_fragment"
        tools:layout="@layout/fragment_socity">
        <argument
            android:name="name"
            app:argType="integer"/>
    </fragment>

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.MainFragment"
        android:label="main_fragment"
        tools:layout="@layout/fragment_main"/>
    <fragment
        android:id="@+id/reelFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.ReelFragment"
        android:label="reel_fragment"
        tools:layout="@layout/fragment_reel"/>
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.SettingFragment"
        android:label="setting_fragment"
        tools:layout="@layout/fragment_setting"/>
    <fragment
        android:id="@+id/mediaPlayFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.MediaPlayFragment"
        android:label="media_play_fragment"
        tools:layout="@layout/fragment_media_play">
        <argument
            android:name="videoPath"
            app:argType="string" />
        <argument
            android:name="videoTitle"
            app:argType="string" />
        <argument
            android:name="isAudio"
            app:argType="boolean"
            android:defaultValue="false"/>

        <deepLink app:uri="app://videodownloader/play?videoPath={videoPath}&amp;videoTitle={videoTitle}&amp;isAudio={isAudio}" />
    </fragment>

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.PlayerFragment"
        android:label="player_fragment"
        tools:layout="@layout/fragment_player"/>

    <fragment
        android:id="@+id/downloadFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.DownloadFragment"
        tools:layout="@layout/fragment_download"/>
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.HistoryFragment"
        tools:layout="@layout/fragment_history"/>

    <fragment
        android:id="@+id/bookMarkFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.BookMarkFragment"
        tools:layout="@layout/fragment_history"/>

    <fragment
        android:id="@+id/inAppBrowserFragment"
        android:name="com.codecx.videodownloader.features.ui.fragments.InAppBrowserFragment"
        tools:layout="@layout/fragment_in_app_browser"/>

</navigation>